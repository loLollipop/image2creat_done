# =============================================================================
# GPT Image Studio — environment template
# Copy this file to `.env` and fill in your secrets. Never commit `.env` itself.
# =============================================================================

# --- HTTP server -------------------------------------------------------------
PORT=3000

# --- MySQL -------------------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=gpt_image_studio
MYSQL_CONNECTION_LIMIT=10
MYSQL_CREATE_DATABASE=true

# --- Admin bootstrap ---------------------------------------------------------
# First boot will create or activate this admin account if both are set.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Admin

# --- Upstream image API ------------------------------------------------------
# image2creat_done can be configured with two presets at the same time and
# you toggle which one is live from the admin "接口设置" page. Both presets
# must be OpenAI-compatible (i.e. POST /v1/images/generations + Bearer auth).
#
# Preset 1 — chatgpt2api (the default, docker-compose-internal upstream).
# Examples:
#   - Official OpenAI:        https://api.openai.com/v1
#   - chatgpt2api (in compose): http://chatgpt2api:80/v1
#   - Self-hosted gateway:    https://your-gateway/v1
AI_API_BASE_URL=
AI_API_KEY=
IMAGE_MODEL=GPT-IMAGE-2

# Preset 2 — CPA (CLIProxyAPI or any other OpenAI-compatible bearer endpoint;
# e.g. the Codex / Cherry Studio key you've already minted). Leave blank to
# disable. The admin can switch ACTIVE_UPSTREAM later from the UI without
# restarting.
CPA_API_BASE_URL=
CPA_API_KEY=
CPA_IMAGE_MODEL=

# Which preset is live at first boot. Valid values: "chatgpt2api", "cpa".
# After boot this is stored in the DB and managed from the admin UI.
ACTIVE_UPSTREAM=chatgpt2api

# --- Credits & registration --------------------------------------------------
DEFAULT_CREDITS=10
GENERATION_CREDIT_COST=1
CHECKIN_CREDIT=1
ALLOW_REGISTRATION=true
REQUIRE_APPROVAL=false
MAX_IMAGES_PER_REQUEST=1

# --- Optional: chatgpt2api (auth-key for the upstream container) -------------
# Used by docker-compose.yml; the value is also passed in via AI_API_KEY above.
CHATGPT2API_AUTH_KEY=chatgpt2api

# --- Optional: upstream admin reverse proxy ----------------------------------
# When set, /upstream/* on this server is proxied to that base URL (admin only,
# session-gated). docker-compose.yml sets this automatically; set it manually if
# you run the app outside of compose.
# UPSTREAM_PROXY_BASE_URL=http://127.0.0.1:8080
